{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FD Claude Guard",
  "version": "0.4.3",
  "identifier": "com.fdtools.claude-guard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "hud",
        "title": "FD Claude Guard 悬浮状态卡",
        "url": "hud.html",
        "width": 360,
        "height": 306,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"],
        "installerHooks": "./nsis/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyNERENENCRjAwM0UzRkQKUldUOTR3UHd5OVJOVW1UdFBTTGN3R2h1L2FNZEx4aXFFT0xEYjcreDZ5aEhFeXhna1VoeUdGbTQK",
      "endpoints": [
        "https://github.com/CaesarLastKing/FD-ClaudeGuard/releases/latest/download/latest.json"
      ]
    }
  }
}
